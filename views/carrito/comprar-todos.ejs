<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Confirmar Compra</title>
    <link rel="stylesheet" href="css/stylesPartials.css">
    <link rel="stylesheet" href="css/stylesCompra.css">
    <script src="https://kit.fontawesome.com/961856c0dd.js" crossorigin="anonymous"></script>


    <body>

        <%- include('../partials/header') %>

    <h1>Confirmar Compra</h1>

    <div class="product-container">
        <% if (Array.isArray(productos)) { %>
            <h2>Todos os Produtos</h2>
            <% let totalCompra = 0; %>
            <% productos.forEach(producto => { %>
                <div class="product-card">
                    <img src="<%= producto.imagen %>" alt="<%= producto.nombre %>">
                    <div class="product-details">
                        <p><strong><%= producto.nombre %></strong></p>
                        <p>Preço: R$ <%= producto.precio.toFixed(2) %></p>
                        <p>Quantidade: <%= producto.cantidad %></p>
                        <p>Total: R$ <%= (producto.precio * producto.cantidad).toFixed(2) %></p>
                    </div>
                </div>
                <% totalCompra += producto.precio * producto.cantidad; %>
            <% }) %>

            <div class="total-price">
                <p><strong>Valor Total: R$ <%= totalCompra.toFixed(2) %></strong></p>
            </div>
        <% } else { %>
            <h2>Produto: <%= item.nombre %></h2>
            <p>Preço: R$ <%= item.precio %></p>
            <p>Quantidade: <%= item.cantidad %></p>
            <p>Total: R$ <%= (item.precio * item.cantidad).toFixed(2) %></p>
        <% } %>

        <form action="/compra-finalizada" method="POST">
            <button type="submit" class="checkout-btn">Finalizar Compra</button>
        </form>

        <a href="/carrito" class="back-to-cart-btn">Voltar ao Carrinho</a>
    </div>

    <%- include('../partials/footer') %>
    
</body>
</html>