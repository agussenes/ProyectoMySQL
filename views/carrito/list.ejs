<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Carrito de Compras</title>
    <link rel="stylesheet" href="/css/stylesCarrito.css">
    <link rel="stylesheet" href="css/stylesPartials.css">
    <script src="https://kit.fontawesome.com/961856c0dd.js" crossorigin="anonymous"></script>
</head>
<body>
    <%- include('../partials/header') %>

    <div id="cart-container">
        <h1 class="cart-title">Mi Carrito</h1>
    
        <div class="cart-items-container">
            <!-- Coluna da esquerda: Itens do carrinho -->
            <div class="cart-items">
                <% if (productos.length === 0) { %>
                    <p class="empty-cart">El carrito esta vacio.</p>
                <% } else { %>
                    <% productos.forEach(producto => { %>
                        <div class="cart-item">
                            <img src="/images/<%= producto.imagen %>" alt="<%= producto.nombre %>" class="cart-item-image">

                            <div class="cart-item-details">
                                <h3><%= producto.nombre %></h3>
                                <p><%= producto.precio %> x <%= producto.cantidad %></p>
                            </div>
                            <div class="cart-item-actions">
        
                                <form action="/carrito/delete/<%= producto.producto_id %>?_method=DELETE" method="POST">
                                    <button type="submit" class="btn-action remove-btn">Eliminar</button>
                                </form>
                                
                                
                                
                                
                            </div>
                        </div>
                    <% }) %>
                <% } %>
            </div>
            
            <!-- Coluna da direita: Total e Finalizar Compra -->
            <div class="cart-summary">
                <p>Total: <%= total %></p>
                <form action="/carrito/comprar-todos" method="POST">
                    <button type="submit" class="checkout-btn">Comprar</button>
                </form>
                <a href="/catalogo" class="continue-shopping-btn">Seguir comprando</a>
            </div>
        </div>
    </div>

    <%- include('../partials/footer') %>

    <script src="/js/scriptNavbar.js"></script>
</body>
</html>
